generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id            String   @id @default(cuid())
  name          String
  artworkDefs   String? // thư viện SVG <defs> dùng chung: mascot <symbol>, gradient, props…
  aspectRatio   String   @default("16:9") // "16:9" | "9:16" | "1:1" | "4:5" | "1.85:1" | "2.39:1"
  resolution    String   @default("1K") // "1K" | "2K" | "4K"
  playbackSpeed Float    @default(1.5) // giây/frame cho preview
  sheetUrl      String?
  musicPath     String? // nhạc nền {projectId}/audio/music.wav — duck dưới thoại
  wmPosition    String   @default("bottom-right") // 4 góc + "center"
  wmScale       Float    @default(12) // % chiều rộng ảnh
  wmOpacity     Float    @default(0.85)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  frames        Frame[]
  assets        Asset[]
  directorRuns  DirectorRun[]
  demoSession   String? // DEMO_MODE: phiên tạo project (giới hạn/xoá sau 24h)
}

model Frame {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  index        Int // 1-based → hiển thị F01, F02...
  shotType     String
  description  String
  artworkSvg   String? // body SVG của cảnh (agent viết, không có root <svg>)
  status       String    @default("draft") // draft|done|failed
  imagePath    String? // ảnh đã watermark (hiển thị)
  rawImagePath String? // ảnh render gốc chưa watermark
  errorMsg     String?
  generatedAt  DateTime?
  // Motion (construct v4): frame là MỘT shot hoạt hình — poster frame là ảnh tĩnh ở trên
  motionSpec     String? // JSON motion spec agent gửi (nguồn chân lý của clip)
  clipDir        String? // thư mục chuỗi PNG: {projectId}/clips/{frameId}/0001.png…
  clipPath       String? // animated WebP xem nhanh
  clipFps        Int?
  clipFrameCount Int?
  clipDuration   Float? // giây — thời lượng shot trên timeline
  // Thoại (audio v1): văn bản + giọng (TTS local hoặc WAV agent gửi)
  dialogue       String? // câu thoại — phụ đề + lip-sync fallback
  voicePath      String? // {projectId}/audio/{frameId}.wav
  voiceDuration  Float?
  voiceOffset    Float    @default(0) // giây từ đầu shot tới lúc bắt đầu nói
  // Sequence (dựng phim): cảnh + chuyển cảnh VÀO frame này
  scene              String? // nhãn cảnh ("SC01 — Buổi sáng") — gom shot, lint liên tục
  transition         String  @default("cut") // cut|dissolve|fadeBlack|fadeWhite|wipeLeft|wipeRight|slideLeft|slideRight
  transitionDuration Float   @default(0.5)

  @@unique([projectId, index])
}

model Asset {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      String // "watermark" (=1)
  filePath  String
  mimeType  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// ── Storyboard Studio Director (Nemotron crew) ──
// Một lần chạy Director trên một project: story → plan → cast → vẽ → critic → editor.
model DirectorRun {
  id           String         @id @default(cuid())
  projectId    String
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  story        String
  language     String         @default("en")
  style        String         @default("storybook")
  status       String         @default("running") // running|done|failed|cancelled|budget_exceeded
  provider     String         @default("nemotron") // nemotron|mock
  models       String // JSON {strong, mid, fast, vision}
  config       String // JSON budgets + options (critic, research…)
  bible        String? // JSON Cast & Set Bible (+ reference notes)
  summary      String? // JSON final metrics (shots, repairs, critic uplift, lint)
  tokensIn     Int            @default(0)
  tokensOut    Int            @default(0)
  costUsd      Float          @default(0)
  error        String?
  startedAt    DateTime       @default(now())
  finishedAt   DateTime?
  steps        DirectorStep[]

  @@index([projectId])
}

model DirectorStep {
  id            String      @id @default(cuid())
  runId         String
  run           DirectorRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  seq           Int // thứ tự trong run
  shotIndex     Int? // frame index (1-based) — null cho bước cấp project
  role          String // researcher|director|cast|artist|critic|editor|dialogue|system
  model         String
  action        String // plan|defs|draw|repair|critique|revise|lint-fix|continuity|voice|research…
  promptHash    String?
  outputSummary String?
  output        String? // JSON/text đầu ra (cắt ngắn) — trace đầy đủ
  critiqueScore Float?
  attempt       Int         @default(0)
  latencyMs     Int         @default(0)
  tokensIn      Int         @default(0)
  tokensOut     Int         @default(0)
  costUsd       Float       @default(0)
  imagePath     String? // snapshot PNG (critic before/after) — storage relative
  error         String?
  createdAt     DateTime    @default(now())

  @@unique([runId, seq])
  @@index([runId])
}
