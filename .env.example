# Database (SQLite via Prisma)
DATABASE_URL="file:./prisma/dev.db"

# Rendered image storage directory
STORAGE_ROOT="./storage"

# Google Sheets service account (OPTIONAL — only for importing scripts from
# a Google Sheet; the TSV paste path needs no setup at all).
# Flatten the service-account JSON to a single line. See README → Environment.
GOOGLE_SERVICE_ACCOUNT_JSON=""

# ── Storyboard Studio Director (optional — the zero-key engine works without any of this) ──
# Nebius Token Factory (OpenAI-compatible). Server-side only; never exposed to the browser.
NEBIUS_API_KEY=""
NEBIUS_BASE_URL="https://api.tokenfactory.nebius.com/v1"
# Crew model ids per tier — verify with `npm run director:models` (GET /v1/models).
# Empty = defaults in src/lib/providers/index.ts (verified 2026-09-26 against the live catalog):
#   STRONG (Director/planning)  nvidia/Nemotron-3-Ultra-550b-a55b
#   MID    (Artist/Cast)        nvidia/nemotron-3-super-120b-a12b
#   FAST   (Critic text/Editor) nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
#   VISION empty = auto-detect a Nemotron Omni. None is listed on Token Factory today, so the
#          critic runs in TEXT mode; an exact listed vision id (e.g. a VLM) switches it to images.
NEMOTRON_STRONG_MODEL=""
NEMOTRON_MID_MODEL=""
NEMOTRON_FAST_MODEL=""
NEMOTRON_VISION_MODEL=""
# Optional exact prices (USD per 1M tokens, [input, output]) — overrides the family estimates.
NEBIUS_PRICES_JSON=""
# "mock" = scripted demo crew, no key, no network (UI demos, e2e, video dry-runs). Labelled "mock" everywhere.
LLM_PROVIDER=""
# Per-run hard caps (server-side ceiling; a request may lower them, never raise them).
DIRECTOR_MAX_SHOTS="12"
DIRECTOR_MAX_TOKENS_PER_RUN="600000"
DIRECTOR_MAX_USD_PER_RUN="1.5"
DIRECTOR_MAX_WALL_SECONDS="1200"
# Shots drawn in parallel per run (1–6). Cuts wall time; costs are unchanged.
DIRECTOR_CONCURRENCY="3"
# Live scripts (smoke/showcase/bench) stop when the spend ledger passes this line.
SPEND_ALERT_USD="15"

# Tavily researcher (optional — enables "Reference research" in the Director).
TAVILY_API_KEY=""
TAVILY_BASE_URL="https://api.tavily.com"

# Public demo mode: passcode gate + caps (≤12 shots, 1K, 12 fps are the Director defaults).
DEMO_MODE="false"
DEMO_PASSCODE=""
DEMO_MAX_PROJECTS_PER_SESSION="3"
DEMO_DAILY_TOKEN_BUDGET="3000000"
DEMO_MAX_CONCURRENT_RUNS="2"
DEMO_RETENTION_HOURS="24"
